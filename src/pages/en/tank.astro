---
import MainLayout from '../../layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import orisaImg from '../../../public/images/PERSO_FULL/orisa.png';
import zaryaImg from '../../../public/images/PERSO_FULL/zarya.png';
import reinhardtImg from '../../../public/images/PERSO_FULL/reinhardt.png';
import dvaImg from '../../../public/images/PERSO_FULL/dva.png';
import junkerqueenImg from '../../../public/images/PERSO_FULL/junkerqueen.png';
import tankLogo from '../../../public/images/ICONES_ROLES/Dark_Circle_Tank.png';
---
<MainLayout>
  <section class="hero-section hero-section-center-flex">
    <div class="role-title-row">
      <Image src={tankLogo} alt="Tank Logo" class="role-logo-sobre" />
      <span class="role-title-main">TANKS</span>
    </div>
  </section>
  <main class="tank-main-esport-glass">
    <div class="tank-hero-grid-esport-esport-glow">
      <div class="tank-hero-grid-esport">
        <!-- Junker Queen S Tier -->
        <div class="tank-hero-card-sobre s">
          <div class="tank-tier-badge-sobre s">S</div>
          <Image src={junkerqueenImg} alt="Junker Queen" class="tank-hero-full-sobre" width={54} height={54} />
          <div class="tank-hero-info-sobre">
            <div class="tank-hero-name-sobre">JUNKER QUEEN</div>
            <div class="tank-hero-role-sobre">TANK</div>
            <a href="/en/builds/junkerqueen" class="tank-hero-btn-sobre"><span class="btn-details-text">BUILD DETAILS</span></a>
          </div>
        </div>
        <!-- Orisa S Tier -->
        <div class="tank-hero-card-sobre s">
          <div class="tank-tier-badge-sobre s">S</div>
          <Image src={orisaImg} alt="Orisa" class="tank-hero-full-sobre" width={54} height={54} />
          <div class="tank-hero-info-sobre">
            <div class="tank-hero-name-sobre">ORISA</div>
            <div class="tank-hero-role-sobre">TANK</div>
            <a href="/en/builds/orisa" class="tank-hero-btn-sobre"><span class="btn-details-text">BUILD DETAILS</span></a>
          </div>
        </div>
        <!-- Zarya S Tier -->
        <div class="tank-hero-card-sobre s">
          <div class="tank-tier-badge-sobre s">S</div>
          <Image src={zaryaImg} alt="Zarya" class="tank-hero-full-sobre" width={54} height={54} />
          <div class="tank-hero-info-sobre">
            <div class="tank-hero-name-sobre">ZARYA</div>
            <div class="tank-hero-role-sobre">TANK</div>
            <a href="/en/builds/zarya" class="tank-hero-btn-sobre"><span class="btn-details-text">BUILD DETAILS</span></a>
          </div>
        </div>
        <!-- Reinhardt A Tier -->
        <div class="tank-hero-card-sobre a">
          <div class="tank-tier-badge-sobre a">A</div>
          <Image src={reinhardtImg} alt="Reinhardt" class="tank-hero-full-sobre" width={54} height={54} />
          <div class="tank-hero-info-sobre">
            <div class="tank-hero-name-sobre">REINHARDT</div>
            <div class="tank-hero-role-sobre">TANK</div>
            <a href="/en/builds/reinhardt" class="tank-hero-btn-sobre"><span class="btn-details-text">BUILD DETAILS</span></a>
          </div>
        </div>
        <!-- D.Va B Tier -->
        <div class="tank-hero-card-sobre b">
          <div class="tank-tier-badge-sobre b">B</div>
          <Image src={dvaImg} alt="D.Va" class="tank-hero-full-sobre" width={54} height={54} />
          <div class="tank-hero-info-sobre">
            <div class="tank-hero-name-sobre">D.VA</div>
            <div class="tank-hero-role-sobre">TANK</div>
            <a href="/en/builds/dva" class="tank-hero-btn-sobre"><span class="btn-details-text">BUILD DETAILS</span></a>
          </div>
        </div>
      </div>
    </div>
  </main>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue:wght@400;700&display=swap');
    /* Correction fond : identique à MainLayout */
    html, body {
      background: linear-gradient(135deg, #131a24 60%, #23272a 100%) !important;
      color: #fff;
      font-family: 'Open Sans', Arial, sans-serif;
      min-height: 100vh;
      width: 100%;
      max-width: 100vw;
      overflow-x: hidden;
    }
    :root {
      background: none !important;
    }
    .tank-hero-grid-esport {
      background: none !important;
      position: relative;
      z-index: 1;
    }
    .tank-hero-grid-esport {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 24px 16px;
      justify-items: center;
      align-items: stretch;
      max-width: 900px;
      width: 100%;
      margin: 0 auto;
      padding-bottom: 20px;
    }
    .tank-hero-card-sobre {
      background: rgba(24,28,34,0.97);
      border-radius: 14px;
      border: 2px solid #232b36;
      box-shadow: 0 2px 12px #12171d33;
      padding: 16px 16px 12px 16px;
      min-width: 0;
      min-height: 190px;
      max-width: 220px;
      width: 100%;
      transition: box-shadow 0.18s, border 0.18s, background 0.18s, transform 0.14s;
      position: relative;
      overflow: hidden;
      font-family: 'Bebas Neue', 'Montserrat', Arial, sans-serif;
      font-size: 1.04rem;
      font-weight: 900;
      color: #fff;
      letter-spacing: 2px;
      text-align: center;
      margin-bottom: 0;
      cursor: pointer;
      outline: none;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      box-sizing: border-box;
    }
    .tank-hero-card-sobre.s { border-color: #ffb300; }
    .tank-hero-card-sobre.a { border-color: #2196f3; }
    .tank-hero-card-sobre.b { border-color: #8da2c7; }
    .tank-hero-card-sobre:hover, .tank-hero-card-sobre:focus {
      border-color: #ffa000;
      box-shadow: 0 0 28px 0 #ffa00055;
      background: rgba(34,39,44,1);
      transform: translateY(-5px) scale(1.025);
      z-index: 2;
    }
    .tank-hero-full-sobre {
      width: 54px;
      height: 54px;
      margin-bottom: 8px;
      object-fit: contain;
      image-rendering: auto;
      filter: none;
      transition: filter 0.18s, transform 0.14s;
    }
    .tank-hero-card-sobre:hover .tank-hero-full-sobre,
    .tank-hero-card-sobre:focus .tank-hero-full-sobre {
      filter: drop-shadow(0 0 8px #ffa000bb);
      transform: scale(1.04) rotate(-2deg);
    }
    .tank-tier-badge-sobre {
      position: absolute;
      top: 10px;
      left: 10px;
      font-size: 0.89rem;
      font-family: 'Bebas Neue', 'Montserrat', Arial, sans-serif;
      padding: 2px 10px 1px 10px;
      border-radius: 9px;
      font-weight: 900;
      background: #232b36;
      border: 2px solid #232b36;
      color: #fff;
      letter-spacing: 1.2px;
      z-index: 2;
      opacity: 0.95;
      box-shadow: none;
    }
    .tank-tier-badge-sobre.s { background: #ffb300; color: #181c22; border-color: #ffb300; }
    .tank-tier-badge-sobre.a { background: #2196f3; color: #fff; border-color: #2196f3; }
    .tank-tier-badge-sobre.b { background: #8da2c7; color: #fff; border-color: #8da2c7; }
    .tank-hero-name-sobre {
      font-size: 1.05rem;
      font-family: 'Bebas Neue', 'Montserrat', Arial, sans-serif;
      color: #ffb300;
      letter-spacing: 2.5px;
      font-weight: 900;
      margin-bottom: 2px;
      text-shadow: none;
      text-transform: uppercase;
    }
    .tank-hero-role-sobre {
      font-size: 0.91rem;
      color: #fff;
      opacity: 0.7;
      margin-bottom: 10px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }
    .tank-hero-btn-sobre {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #232b36;
      color: #ffb300;
      font-weight: 700;
      font-size: 0.91rem;
      padding: 7px 18px;
      border-radius: 11px;
      text-decoration: none;
      box-shadow: none;
      border: 2px solid #232b36;
      margin-top: 10px;
      align-self: center;
      width: fit-content;
      min-width: 0;
      text-transform: uppercase;
      letter-spacing: 1.3px;
      transition: box-shadow 0.12s, border 0.12s, background 0.12s, color 0.12s, transform 0.10s;
      cursor: pointer;
    }
    .tank-hero-btn-sobre:hover, .tank-hero-btn-sobre:focus {
      background: #ffb300;
      color: #181c22;
      border: 2px solid #ffb300;
      box-shadow: 0 0 12px 0 #ffb30055;
      transform: scale(1.04);
    }
    @media (max-width: 900px) {
      .tank-hero-grid-esport {
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 14px 0;
        max-width: 98vw;
      }
      .tank-hero-card-sobre {
        max-width: 97vw;
        padding: 12px 5px 10px 5px;
      }
    }
    @media (max-width: 650px) {
      .tank-hero-grid-esport {
        grid-template-columns: 1fr;
        gap: 8px 0;
        max-width: 99vw;
      }
      .tank-hero-card-sobre {
        min-width: 100px;
        width: 100%;
        max-width: 320px;
        padding: 8px 2px 8px 2px;
      }
    }
  </style>
</MainLayout> 