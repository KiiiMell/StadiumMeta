---
import MainLayout from '../../layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import cassidyImg from '../../../public/images/PERSO_FULL/cassidy.png';
import asheImg from '../../../public/images/PERSO_FULL/ashe.png';
import genjiImg from '../../../public/images/PERSO_FULL/genji.png';
import soldier76Img from '../../../public/images/PERSO_FULL/soldier76.png';
import reaperImg from '../../../public/images/PERSO_FULL/reaper.png';
import meiImg from '../../../public/images/PERSO_FULL/mei.png';
import damageLogo from '../../../public/images/ICONES_ROLES/Dark_Circle_Damage.png';
---
<MainLayout>
  <section class="hero-section hero-section-center-flex">
    <div class="role-title-row">
      <Image src={damageLogo} alt="Damage Logo" class="role-logo-sobre" />
      <span class="role-title-main">DAMAGE</span>
    </div>
  </section>
  <main class="tank-main-sobre">
    <div class="tank-hero-grid-sobre">
      <!-- S Tier -->
      <div class="tank-hero-card-sobre s">
        <div class="tank-tier-badge-sobre s">S</div>
        <Image src={cassidyImg} alt="Cassidy" class="tank-hero-full-sobre" width={54} height={54} />
        <div class="tank-hero-info-sobre">
          <div class="tank-hero-name-sobre">CASSIDY</div>
          <div class="tank-hero-role-sobre">DPS</div>
          <a href="/en/builds/cassidy" class="tank-hero-btn-sobre"><span class="btn-details-text">BUILD DETAILS</span></a>
        </div>
      </div>
      <div class="tank-hero-card-sobre s">
        <div class="tank-tier-badge-sobre s">S</div>
        <Image src={asheImg} alt="Ashe" class="tank-hero-full-sobre" width={54} height={54} />
        <div class="tank-hero-info-sobre">
          <div class="tank-hero-name-sobre">ASHE</div>
          <div class="tank-hero-role-sobre">DPS</div>
          <a href="/en/builds/ashe" class="tank-hero-btn-sobre"><span class="btn-details-text">BUILD DETAILS</span></a>
        </div>
      </div>
      <!-- A Tier -->
      <div class="tank-hero-card-sobre a">
        <div class="tank-tier-badge-sobre a">A</div>
        <Image src={genjiImg} alt="Genji" class="tank-hero-full-sobre" width={54} height={54} />
        <div class="tank-hero-info-sobre">
          <div class="tank-hero-name-sobre">GENJI</div>
          <div class="tank-hero-role-sobre">DPS</div>
          <a href="/en/builds/genji" class="tank-hero-btn-sobre"><span class="btn-details-text">BUILD DETAILS</span></a>
        </div>
      </div>
      <div class="tank-hero-card-sobre a">
        <div class="tank-tier-badge-sobre a">A</div>
        <Image src={soldier76Img} alt="Soldier: 76" class="tank-hero-full-sobre" width={54} height={54} />
        <div class="tank-hero-info-sobre">
          <div class="tank-hero-name-sobre">SOLDIER: 76</div>
          <div class="tank-hero-role-sobre">DPS</div>
          <a href="/en/builds/soldier76" class="tank-hero-btn-sobre"><span class="btn-details-text">BUILD DETAILS</span></a>
        </div>
      </div>
      <!-- B Tier -->
      <div class="tank-hero-card-sobre b">
        <div class="tank-tier-badge-sobre b">B</div>
        <Image src={reaperImg} alt="Reaper" class="tank-hero-full-sobre" width={54} height={54} />
        <div class="tank-hero-info-sobre">
          <div class="tank-hero-name-sobre">REAPER</div>
          <div class="tank-hero-role-sobre">DPS</div>
          <a href="/en/builds/reaper" class="tank-hero-btn-sobre"><span class="btn-details-text">BUILD DETAILS</span></a>
        </div>
      </div>
      <div class="tank-hero-card-sobre b">
        <div class="tank-tier-badge-sobre b">B</div>
        <Image src={meiImg} alt="Mei" class="tank-hero-full-sobre" width={54} height={54} />
        <div class="tank-hero-info-sobre">
          <div class="tank-hero-name-sobre">MEI</div>
          <div class="tank-hero-role-sobre">DPS</div>
          <a href="/en/builds/mei" class="tank-hero-btn-sobre"><span class="btn-details-text">BUILD DETAILS</span></a>
        </div>
      </div>
    </div>
  </main>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue:wght@400;700&display=swap');
    html, body {
      background: linear-gradient(135deg, #131a24 60%, #23272a 100%) !important;
      color: #fff;
      font-family: 'Open Sans', Arial, sans-serif;
      min-height: 100vh;
      box-sizing: border-box;
    }
    .tank-main-sobre {
      background: none !important;
      min-height: 100vh;
      padding: 0;
      margin: 0;
    }
    .tank-hero-grid-sobre {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 24px 16px;
      justify-items: center;
      align-items: stretch;
      max-width: 900px;
      width: 100%;
      margin: 0 auto;
      padding-bottom: 20px;
    }
    .tank-hero-card-sobre {
      background: rgba(24,28,34,0.97);
      border-radius: 14px;
      border: 2px solid #232b36;
      box-shadow: 0 2px 12px #12171d33;
      padding: 16px 16px 12px 16px;
      min-width: 0;
      min-height: 190px;
      max-width: 220px;
      width: 100%;
      transition: box-shadow 0.18s, border 0.18s, background 0.18s, transform 0.14s;
      position: relative;
      overflow: hidden;
      font-family: 'Bebas Neue', 'Montserrat', Arial, sans-serif;
      font-size: 1.04rem;
      font-weight: 900;
      color: #fff;
      letter-spacing: 2px;
      text-align: center;
      cursor: pointer;
      outline: none;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      box-sizing: border-box;
    }
    .tank-hero-card-sobre.s { border-color: #ffb300; }
    .tank-hero-card-sobre.a { border-color: #2196f3; }
    .tank-hero-card-sobre.b { border-color: #8da2c7; }
    .tank-hero-card-sobre:hover, .tank-hero-card-sobre:focus {
      border-color: #ffa000;
      box-shadow: 0 0 28px 0 #ffa00055;
      background: rgba(34,39,44,1);
      transform: translateY(-5px) scale(1.025);
      z-index: 2;
    }
    .tank-hero-full-sobre {
      width: 54px;
      height: 54px;
      margin-bottom: 8px;
      object-fit: contain;
      image-rendering: auto;
      filter: none;
      transition: filter 0.18s, transform 0.14s;
    }
    .tank-hero-card-sobre:hover .tank-hero-full-sobre,
    .tank-hero-card-sobre:focus .tank-hero-full-sobre {
      filter: drop-shadow(0 0 8px #ffa000bb);
      transform: scale(1.04) rotate(-2deg);
    }
    .tank-tier-badge-sobre {
      position: absolute;
      top: 10px;
      left: 10px;
      font-size: 0.89rem;
      font-family: 'Bebas Neue', 'Montserrat', Arial, sans-serif;
      font-weight: 700;
      padding: 0.22em 0.8em;
      border-radius: 12px;
      background: #232b36;
      z-index: 2;
      letter-spacing: 1.2px;
      border: 1.5px solid #232b36;
      opacity: 0.95;
      box-shadow: none;
    }
    .tank-tier-badge-sobre.s { background: #ffb300; color: #181c22; border-color: #ffb300; }
    .tank-tier-badge-sobre.a { background: #2196f3; color: #fff; border-color: #2196f3; }
    .tank-tier-badge-sobre.b { background: #8da2c7; color: #fff; border-color: #8da2c7; }
    .tank-hero-name-sobre {
      font-size: 1.05rem;
      font-family: 'Bebas Neue', 'Montserrat', Arial, sans-serif;
      color: #ffb300;
      letter-spacing: 2.5px;
      font-weight: 900;
      margin-bottom: 2px;
      text-shadow: none;
      text-transform: uppercase;
    }
    .tank-hero-role-sobre {
      font-size: 0.91rem;
      color: #fff;
      opacity: 0.7;
      margin-bottom: 10px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }
    .tank-hero-info-sobre {
      margin-top: 0.9rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.3rem;
      width: 100%;
    }
    .tank-hero-btn-sobre {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #232b36;
      color: #ffb300;
      font-weight: 700;
      font-size: 0.91rem;
      padding: 7px 18px;
      border-radius: 11px;
      text-decoration: none;
      box-shadow: none;
      border: 2px solid #232b36;
      margin-top: 10px;
      align-self: center;
      width: fit-content;
      cursor: pointer;
    }
    .tank-hero-btn-sobre:hover, .tank-hero-btn-sobre:focus {
      background: #ffb300;
      color: #181c22;
      border: 2px solid #ffb300;
      box-shadow: 0 0 12px 0 #ffb30055;
      transform: scale(1.04);
    }
    .role-title-main {
      font-size: 2.3rem;
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-weight: 900;
      letter-spacing: 2px;
      color: #FFA000 !important;
      text-shadow: 0 2px 14px #2196F3cc, 0 0px 18px #FFA00099, 0 0 1px #2196F3;
      text-transform: uppercase;
      margin: 0;
      padding: 0 8px;
      line-height: 1;
      display: inline-block;
    }
    .role-logo-sobre {
      width: 38px;
      height: 38px;
      filter: drop-shadow(0 0 8px #2196F3cc) drop-shadow(0 0 10px #FFA00099);
      vertical-align: middle;
    }
    .role-title-row {
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 32px 0 18px 0;
      gap: 16px;
    }
    @media (max-width: 900px) {
      .tank-hero-grid-sobre {
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 14px 0;
        max-width: 98vw;
      }
      .tank-hero-card-sobre {
        max-width: 97vw;
        padding: 12px 5px 10px 5px;
      }
    }
    @media (max-width: 650px) {
      .tank-hero-grid-sobre {
        grid-template-columns: 1fr;
        gap: 8px 0;
        max-width: 99vw;
      }
      .tank-hero-card-sobre {
        min-width: 100px;
        width: 100%;
        max-width: 320px;
        padding: 8px 2px 8px 2px;
      }
    }
  </style>
</MainLayout> 