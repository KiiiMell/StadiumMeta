---
import MainLayout from '../../../layouts/MainLayout.astro';
---
<MainLayout>
  <main class="dva-build-main-small">
    <div class="dva-build-center">
      <!-- Premier build -->
      <section class="dva-build-block">
        <header class="dva-build-header-small">
          <img src="/images/ICONES_PERSO/Icon-DVa.png" alt="D.Va" class="dva-avatar-small" />
          <div>
            <h1 class="dva-title-small">Build D.Va <span>DEGÂTS DES COMPÉTENCES + TEMPS DE RECHARGE MÉCA</span></h1>
            <p class="dva-desc-small">Build orienté puissance des compétences et récupération rapide du méca.</p>
          </div>
        </header>
        <!-- Les boutons perks côte à côte -->
        <div class="dva-build-cards">
          <div class="dva-group-card">
            <div class="dva-group-title dva-group-title-hover">
              Perks Puissance (4/4)
              <div class="dva-perks-popup">
                <div class="dva-perks-row">
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/PUISSANCE/FUSION_CIBLÉE.png" alt="Fusion Ciblée" />
                  </div>
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/PUISSANCE/SURSTOCKAGE.png" alt="Surstockage" />
                  </div>
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/PUISSANCE/MATRICE_ULTRA-LARGE.png" alt="Matrice Ultra-large" />
                  </div>
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/PUISSANCE/FRAPPE_MEKA.png" alt="Frappe MEKA" />
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="dva-group-card">
            <div class="dva-group-title dva-group-title-hover">
              Perks Utilitaires (6/6)
              <div class="dva-perks-popup">
                <div class="dva-perks-row">
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/CAPACITE/EPIQUE/ARSENAL_HEROIQUE.png" alt="Arsenal Héroïque" />
                  </div>
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/ARME/EPIQUE/ARTILLERIE_VOLSKAYA.png" alt="Artillerie Volskaya" />
                  </div>
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/SURVIE/EPIQUE/NANO_COLA_NITRO.png" alt="Nano Cola Nitro" />
                  </div>
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/SURVIE/EPIQUE/CATALYSEUR_NEBULEUX.png" alt="Catalyseur Nébuleux" />
                  </div>
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/CAPACITE/EPIQUE/MOTEUR_A_FUSION_LUMERICO.png" alt="Moteur à Fusion Lumerico" />
                  </div>
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/SURVIE/RARE/SPE_SOLO.png" alt="Spé Solo" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Bloc conseils supprimé à la demande de l'utilisateur -->
      </section>
      <!-- DEUXIEME BUILD D.VA (MAJ: noms officiels FR) -->
      <section class="dva-build-block">
        <header class="dva-build-header-small">
          <img src="/images/ICONES_PERSO/Icon-DVa.png" alt="D.Va" class="dva-avatar-small" />
          <div>
            <h1 class="dva-title-small">Build D.Va <span>CONTRE REIN + BOUCLIER</span></h1>
            <p class="dva-desc-small">Un build qui est efficace contre Reinhardt ou les compositions à boucliers.</p>
          </div>
        </header>
        <div class="dva-build-cards">
          <div class="dva-group-card">
            <div class="dva-group-title dva-group-title-hover">
              Pouvoirs (4/4)
              <div class="dva-perks-popup">
                <div class="dva-perks-row">
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/PUISSANCE/FUSION_CIBLÉE.png" alt="Fusion Ciblée" />
                  </div>
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/PUISSANCE/SURSTOCKAGE.png" alt="Surstockage" />
                  </div>
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/PUISSANCE/MATRICE_ULTRA-LARGE.png" alt="Matrice Ultra-large" />
                  </div>
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/PUISSANCE/PROTECTION_DU_GROUPE.png" alt="Protection du Groupe" />
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="dva-group-card">
            <div class="dva-group-title dva-group-title-hover">
              Objets (6/6)
              <div class="dva-perks-popup">
                <div class="dva-perks-row">
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/CAPACITE/EPIQUE/ORDRE_D'ASSAUT.png" alt="Ordre d'Assaut" />
                  </div>
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/SURVIE/EPIQUE/NANO_COLA_NITRO.png" alt="Nano Cola Nitro" />
                  </div>
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/SURVIE/EPIQUE/CATALYSEUR_NEBULEUX.png" alt="Conduit Nébuleux" />
                  </div>
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/SURVIE/EPIQUE/PUCE_DE_DEVIATION_DES_DEGATS.png" alt="Déflecteur Puçage" />
                  </div>
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/ARME/EPIQUE/MUNITIONS_RECYCLEES.png" alt="Boulets Recyclés" />
                  </div>
                  <div class="perk-mini">
                    <img src="/images/PERKS/DVA/SURVIE/RARE/SPE_SOLO.png" alt="Spé Solo" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <!-- Ici tu pourras ajouter d'autres builds -->
    </div>
  </main>
  <style>
    .dva-build-main-small {
      background: #161d26;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding-top: 2.5rem;
    }
    .dva-build-center {
      width: 650px;
      max-width: 98vw;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2.5rem;
    }
    .dva-build-block {
      width: 100%;
      background: none;
      margin-bottom: 170px;
      border-radius: 16px;
      box-shadow: 0 2px 16px #00eaff11;
      padding-bottom: 0.5rem;
      min-width: 0;
      overflow: visible;
      position: relative;
    }
    .dva-build-header-small {
      display: flex;
      align-items: center;
      gap: 1.1rem;
      margin-bottom: 0.4rem;
    }
    .dva-avatar-small {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      box-shadow: 0 0 10px #00eaff77;
      border: 2px solid #FFD700;
      background: #111a;
    }
    .dva-title-small {
      font-size: 1.1rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 0.1rem;
      letter-spacing: 1px;
    }
    .dva-title-small span {
      color: #00eaff;
      font-size: 1.07rem;
      font-weight: 700;
      letter-spacing: 0.5px;
    }
    .dva-desc-small {
      color: #b3c6e0;
      font-size: 0.97rem;
      margin-top: 0.1rem;
    }
    .dva-build-cards {
      width: 100%;
      display: flex;
      flex-direction: row;
      gap: 1.1rem;
      justify-content: center;
      min-width: 0;
      overflow: visible;
      position: relative;
    }
    .dva-group-card {
      background: #232b36;
      border-radius: 14px;
      box-shadow: 0 2px 10px #00eaff33;
      padding: 0.8rem 0.6rem 0.7rem 0.6rem;
      width: 280px;
      min-width: 220px;
      display: flex;
      flex-direction: column;
      align-items: center;
      border: 1.5px solid #3cefff33;
      position: relative;
      justify-content: center;
      min-height: 48px;
      margin: 0;
      overflow: visible;
    }
    .dva-group-title {
      flex: 1;
      text-align: center;
    }
    .dva-group-title-hover .dva-perks-popup {
      display: none;
      position: absolute;
      left: 50%;
      top: 120%;
      transform: translateX(-50%);
      z-index: 10;
      background: #232b36;
      border: 1.5px solid #3cefff99;
      border-radius: 12px;
      box-shadow: 0 4px 18px #00eaff33;
      padding: 0.7rem 0.7rem 0.5rem 0.7rem;
      min-width: 240px;
      animation: fadeIn 0.2s;
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: 0.7rem;
    }
    .dva-perks-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.7rem;
      justify-content: center;
      flex-direction: row;
    }
    .perk-mini {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 62px;
      gap: 0.18rem;
    }
    .perk-mini img {
      width: 48px;
      height: 48px;
      padding: 6px;
      object-fit: contain;
      background: transparent;
      box-sizing: content-box;
      display: block;
    }
    .perk-mini span {
      color: #fff;
      font-size: 0.74rem;
      text-align: center;
      line-height: 1.1;
      max-width: 60px;
      word-break: break-word;
    }
    @media (max-width: 900px) {
      .dva-build-center {
        width: 99vw;
        max-width: 99vw;
      }
      .dva-group-card {
        width: 99vw;
        min-width: unset;
      }
      .dva-build-block {
        margin-bottom: 110px;
      }
    }
    @media (max-width: 650px) {
      .dva-build-cards {
        flex-direction: column;
        gap: 0.7rem;
        align-items: center;
      }
      .dva-group-card {
        width: 99vw;
        min-width: unset;
      }
      .dva-build-block {
        margin-bottom: 50px;
      }
    }
  </style>
</MainLayout>
