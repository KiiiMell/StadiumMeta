---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout>
  <section class="hero-section hero-section-center-flex">
    <div class="build-title-row">
      <img src="/images/ICONES_PERSO/Icon-Mercy.png" alt="Ange" class="build-logo-orisa" />
      <span class="build-title-main">Build Ange</span>
    </div>
    <span class="build-title-secondary">Soutien - Build personnalisé</span>
  </section>
  <main class="dva-build-main-small">
    <div class="dva-build-center">
      <div class="dva-build-block">
        <div class="dva-build-cards">
          <div class="dva-group-card">
            <div class="dva-group-title dva-group-title-hover">Pouvoirs (4/4)</div>
            <div class="dva-perks-popup">
              <div class="dva-perks-row">
                <div class="perk-mini"><img src="/images/PERKS/ANGE/PUISSANCE/RENAISSANCE.png" alt="Renaissance" /></div>
                <div class="perk-mini"><img src="/images/PERKS/ANGE/PUISSANCE/CERCLE_CREPUSCULAIRE.png" alt="Cercle Crépusculaire" /></div>
              </div>
              <div class="dva-perks-row">
                <div class="perk-mini"><img src="/images/PERKS/ANGE/PUISSANCE/SOINS_D'URGENCE.png" alt="Soins d'Urgence" /></div>
                <div class="perk-mini"><img src="/images/PERKS/ANGE/PUISSANCE/DISTORSION.png" alt="Distorsion" /></div>
              </div>
            </div>
          </div>
          <div class="dva-group-card">
            <div class="dva-group-title dva-group-title-hover">Objets (6/6)</div>
            <div class="dva-perks-popup">
              <div class="dva-perks-row">
                <div class="perk-mini"><img src="/images/PERKS/ANGE/ARME/EPIQUE/CADUCEE_EX.png" alt="Caducée EX" /></div>
                <div class="perk-mini"><img src="/images/PERKS/ANGE/SURVIE/EPIQUE/EVOCATION_EN_CHAINE.png" alt="Evocation en Chaîne" /></div>
                <div class="perk-mini"><img src="/images/PERKS/ANGE/CAPACITE/EPIQUE/RESURRECTION_A_DISTANCE.png" alt="Résurrection à Distance" /></div>
              </div>
              <div class="dva-perks-row">
                <div class="perk-mini"><img src="/images/PERKS/ANGE/CAPACITE/RARE/AILES_A_LONGUES_PORTEE.png" alt="Ailes à Longue Portée" /></div>
                <div class="perk-mini"><img src="/images/PERKS/ANGE/SURVIE/RARE/VETEMENTS_ANGELIQUES.png" alt="Vêtements Angéliques" /></div>
                <div class="perk-mini"><img src="/images/PERKS/ANGE/SURVIE/EPIQUE/SOINS_MARTIENS.png" alt="Soins Martiens" /></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue:wght@400;700&display=swap');
    .build-title-row {
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 32px 0 8px 0;
      gap: 12px;
    }
    .build-logo-orisa {
      width: 38px;
      height: 38px;
      filter: drop-shadow(0 0 6px #2196F3aa) drop-shadow(0 0 8px #FFA00088);
      vertical-align: middle;
    }
    .build-title-main {
      font-size: 2rem;
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-weight: 900;
      letter-spacing: 2px;
      color: #FFA000 !important;
      text-shadow: 0 2px 10px #2196F399, 0 0px 14px #FFA00077;
      text-transform: uppercase;
      margin: 0;
      padding: 0 4px;
      line-height: 1;
      display: inline-block;
    }
    .build-title-secondary {
      color: #fff;
      font-size: 1.07rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      margin-top: 0.2rem;
      margin-bottom: 1.5rem;
      display: block;
      text-align: center;
    }
    .dva-build-main-small {
      background: #161d26;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding-top: 2.5rem;
    }
    .dva-build-center {
      width: 650px;
      max-width: 98vw;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2.5rem;
    }
    .dva-build-block {
      width: 100%;
      background: none;
      margin-bottom: 170px;
      border-radius: 16px;
      box-shadow: 0 2px 16px #00eaff11;
      padding-bottom: 0.5rem;
      min-width: 0;
      overflow: visible;
      position: relative;
    }
    .dva-build-cards {
      width: 100%;
      display: flex;
      flex-direction: row;
      gap: 1.1rem;
      justify-content: center;
      min-width: 0;
      overflow: visible;
      position: relative;
    }
    .dva-group-card {
      background: #232b36;
      border-radius: 14px;
      box-shadow: 0 2px 10px #00eaff33;
      padding: 0.8rem 0.6rem 0.7rem 0.6rem;
      width: 280px;
      min-width: 220px;
      display: flex;
      flex-direction: column;
      align-items: center;
      border: 1.5px solid #3cefff33;
      position: relative;
      justify-content: center;
      min-height: 48px;
      margin: 0;
      overflow: visible;
    }
    .dva-group-title {
      flex: 1;
      text-align: center;
    }
    .dva-perks-row {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      justify-items: center;
    }
    .dva-group-card:last-child .dva-perks-row {
      grid-template-columns: repeat(3, 1fr);
    }
    .perk-mini {
      width: 64px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #181f25;
      border-radius: 10px;
      box-shadow: 0 0 8px #00eaff44;
      border: 2px solid #00eaff33;
      overflow: hidden;
    }
    .perk-mini img {
      width: 48px;
      height: 48px;
      padding: 6px;
      object-fit: contain;
      background: transparent;
      box-sizing: content-box;
      display: block;
    }
    .perk-mini span {
      color: #fff;
      font-size: 0.74rem;
      text-align: center;
      line-height: 1.1;
      max-width: 60px;
      word-break: break-word;
    }
    @media (max-width: 900px) {
      .dva-build-center {
        width: 99vw;
        max-width: 99vw;
      }
      .dva-group-card {
        width: 99vw;
        min-width: unset;
      }
      .dva-build-block {
        margin-bottom: 110px;
      }
    }
    @media (max-width: 650px) {
      .dva-build-cards {
        flex-direction: column;
        gap: 0.7rem;
        align-items: center;
      }
      .dva-group-card {
        width: 99vw;
        min-width: unset;
      }
      .dva-build-block {
        margin-bottom: 50px;
      }
    }
  </style>
</MainLayout>
