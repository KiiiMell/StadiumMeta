---
import MainLayout from '../../../layouts/MainLayout.astro';
---
<MainLayout>
  <section class="hero-section hero-section-center-flex">
    <div class="build-title-row">
      <img src="/images/ICONES_PERSO/Icon-Reinhardt.png" alt="Reinhardt" class="build-logo-orisa" />
      <span class="build-title-main">Build Reinhardt</span>
    </div>
    <span class="build-title-secondary">Tank - Frappe & Contrôle</span>
  </section>
  <main class="dva-build-main-small">
    <div class="dva-build-center">
      <!-- Premier build -->
      <section class="dva-build-block">
        <!-- Ligne des titres -->
        <div class="dva-build-cards">
          <div class="dva-group-card">
            <div class="dva-group-title dva-group-title-hover">Pouvoirs (4/4)</div>
          </div>
          <div class="dva-group-card">
            <div class="dva-group-title dva-group-title-hover">Objets (6/6)</div>
          </div>
        </div>
        <!-- Ligne des grilles d'icônes -->
        <div class="dva-build-cards" style="margin-top: 2.5rem;">
          <div class="dva-group-card">
            <div class="dva-perks-popup">
              <div class="dva-perks-row">
                <div class="perk-mini">
                  <img src="/images/PERKS/REINHARDT/PUISSANCE/RENVERSANT_!.png" alt="Renversant !" />
                </div>
                <div class="perk-mini">
                  <img src="/images/PERKS/REINHARDT/PUISSANCE/TOUT_FEU_TOUT_FLAMME.png" alt="Tout Feu Tout Flamme" />
                </div>
              </div>
              <div class="dva-perks-row">
                <div class="perk-mini">
                  <img src="/images/PERKS/REINHARDT/PUISSANCE/WILHELMWAGEN.png" alt="Wilhelmwagon" />
                </div>
                <div class="perk-mini">
                  <img src="/images/PERKS/REINHARDT/PUISSANCE/RECONSTRUCTION_D'ECRAN.png" alt="Reconstruction d'écran" />
                </div>
              </div>
            </div>
          </div>
          <div class="dva-group-card">
            <div class="dva-perks-popup">
              <div class="dva-perks-row dva-items-row">
                <div class="perk-mini">
                  <img src="/images/PERKS/REINHARDT/SURVIE/EPIQUE/CATALYSEUR_NEBULEUX.png" alt="Catalyseur Nébuleux" />
                </div>
                <div class="perk-mini">
                  <img src="/images/PERKS/REINHARDT/SURVIE/EPIQUE/GANTELET_SINISTRE.png" alt="Gantelet Sinistre" />
                </div>
                <div class="perk-mini">
                  <img src="/images/PERKS/REINHARDT/ARME/EPIQUE/PROPULSEUR_A_REACTION.png" alt="Propulseur à Réaction" />
                </div>
              </div>
              <div class="dva-perks-row dva-items-row">
                <div class="perk-mini">
                  <img src="/images/PERKS/REINHARDT/ARME/EPIQUE/PLAN_Z.png" alt="Plan Z" />
                </div>
                <div class="perk-mini">
                  <img src="/images/PERKS/REINHARDT/ARME/EPIQUE/OEIL_DE_L'ARAIGNEE.png" alt="Oeil de l'Araignée" />
                </div>
                <div class="perk-mini">
                  <img src="/images/PERKS/REINHARDT/ARME/RARE/TECHNOVAMPIRISME.png" alt="Technovampirisme" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue:wght@400;700&display=swap');
    .build-title-row {
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 32px 0 8px 0;
      gap: 12px;
    }
    .build-logo-orisa {
      width: 38px;
      height: 38px;
      filter: drop-shadow(0 0 6px #2196F3aa) drop-shadow(0 0 8px #FFA00088);
      vertical-align: middle;
    }
    .build-title-main {
      font-size: 2rem;
      font-family: 'Bebas Neue', Arial, sans-serif;
      font-weight: 900;
      letter-spacing: 2px;
      color: #FFA000 !important;
      text-shadow: 0 2px 10px #2196F399, 0 0px 14px #FFA00077;
      text-transform: uppercase;
      margin: 0;
      padding: 0 4px;
      line-height: 1;
      display: inline-block;
    }
    .build-title-secondary {
      display: block;
      text-align: center;
      font-size: 1.05rem;
      color: #ffcc80;
      font-family: 'Montserrat', Arial, sans-serif;
      font-weight: 700;
      letter-spacing: 1px;
      margin-top: 2px;
      text-shadow: 0 1px 6px #2196F355;
      text-transform: uppercase;
    }
    .dva-build-main-small {
      background: #161d26;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding-top: 2.5rem;
    }
    .dva-build-center {
      width: 650px;
      max-width: 98vw;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2.5rem;
    }
    .dva-build-block {
      width: 100%;
      background: none;
      margin-bottom: 170px;
      border-radius: 16px;
      box-shadow: 0 2px 16px #00eaff11;
      padding-bottom: 0.5rem;
      min-width: 0;
      overflow: visible;
      position: relative;
    }
    .dva-build-cards {
      width: 100%;
      display: flex;
      flex-direction: row;
      gap: 1.1rem;
      justify-content: center;
      min-width: 0;
      overflow: visible;
      position: relative;
    }
    .dva-group-card {
      background: #232b36;
      border-radius: 14px;
      box-shadow: 0 2px 10px #00eaff33;
      padding: 0.8rem 0.6rem 0.7rem 0.6rem;
      width: 280px;
      min-width: 220px;
      display: flex;
      flex-direction: column;
      align-items: center;
      border: 1.5px solid #3cefff33;
      position: relative;
      justify-content: center;
      min-height: 48px;
      margin: 0;
      overflow: visible;
    }
    .dva-group-title {
      flex: 1;
      text-align: center;
    }
    .dva-perks-row {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      justify-items: center;
    }
    .dva-items-row {
      grid-template-columns: repeat(3, 1fr);
    }
    .perk-mini {
      width: 64px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #181f25;
      border-radius: 10px;
      box-shadow: 0 0 8px #00eaff44;
      border: 2px solid #00eaff33;
      overflow: hidden;
    }
    .perk-mini img {
      width: 48px;
      height: 48px;
      padding: 6px;
      object-fit: contain;
      background: transparent;
      box-sizing: content-box;
      display: block;
    }
  </style>
</MainLayout>
