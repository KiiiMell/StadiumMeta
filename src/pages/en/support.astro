---
import MainLayout from '../../layouts/MainLayout.astro';
---
<MainLayout>
  <section class="role-section">
    <h1 class="role-title">
      <img src="/images/ICONES_ROLES/Dark_Circle_Support.png" alt="Support" class="role-logo" />
      SUPPORT HEROES
    </h1>
    <div class="hero-grid">
      <a href="/en/builds_mercy" class="hero-card-list s-tier">
        <span class="tier-badge">S TIER</span>
        <img src="/images/HEROS/MERCY/MERCY_ICON.webp" alt="Mercy" class="hero-list-img" />
        <h3 class="hero-list-title">MERCY</h3>
        <span class="hero-list-badge">SUPPORT</span>
        <p class="hero-list-desc">Guardian angel with powerful healing abilities</p>
        <button class="hero-list-btn">VIEW BUILDS</button>
      </a>

      <a href="/en/builds_kiriko" class="hero-card-list a-tier">
        <span class="tier-badge">A TIER</span>
        <img src="/images/HEROS/KIRIKO/KIRIKO_ICON.webp" alt="Kiriko" class="hero-list-img" />
        <h3 class="hero-list-title">KIRIKO</h3>
        <span class="hero-list-badge">SUPPORT</span>
        <p class="hero-list-desc">Swift healer with kunai and protection suzu</p>
        <button class="hero-list-btn">VIEW BUILDS</button>
      </a>

      <a href="/en/builds_ana" class="hero-card-list a-tier">
        <span class="tier-badge">A TIER</span>
        <img src="/images/HEROS/ANA/ANA_ICON.webp" alt="Ana" class="hero-list-img" />
        <h3 class="hero-list-title">ANA</h3>
        <span class="hero-list-badge">SUPPORT</span>
        <p class="hero-list-desc">Sniper healer with powerful utility</p>
        <button class="hero-list-btn">VIEW BUILDS</button>
      </a>

      <a href="/en/builds_lucio" class="hero-card-list b-tier">
        <span class="tier-badge">B TIER</span>
        <img src="/images/HEROS/LUCIO/LUCIO_ICON.webp" alt="Lúcio" class="hero-list-img" />
        <h3 class="hero-list-title">LÚCIO</h3>
        <span class="hero-list-badge">SUPPORT</span>
        <p class="hero-list-desc">Mobile support with speed and healing auras</p>
        <button class="hero-list-btn">VIEW BUILDS</button>
      </a>

      <a href="/en/builds_moira" class="hero-card-list b-tier">
        <span class="tier-badge">B TIER</span>
        <img src="/images/HEROS/MOIRA/MOIRA_ICON.webp" alt="Moira" class="hero-list-img" />
        <h3 class="hero-list-title">MOIRA</h3>
        <span class="hero-list-badge">SUPPORT</span>
        <p class="hero-list-desc">Versatile healer with damage capabilities</p>
        <button class="hero-list-btn">VIEW BUILDS</button>
      </a>

      <a href="/en/builds_juno" class="hero-card-list b-tier">
        <span class="tier-badge">B TIER</span>
        <img src="/images/HEROS/JUNO/JUNO_ICON.webp" alt="Juno" class="hero-list-img" />
        <h3 class="hero-list-title">JUNO</h3>
        <span class="hero-list-badge">SUPPORT</span>
        <p class="hero-list-desc">Supportive companion with healing drones</p>
        <button class="hero-list-btn">VIEW BUILDS</button>
      </a>
    </div>
  </section>
</MainLayout> 