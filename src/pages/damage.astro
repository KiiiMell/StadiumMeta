---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout>
  <section class="role-section">
    <h1 class="role-title">
      <img src="/images/ICONES_ROLES/Dark_Circle_Damage.png" alt="Damage" class="role-logo" />
      DAMAGE HEROES
    </h1>
    <div class="hero-grid">
      <a href="builds_genji.html" class="hero-card-list s-tier">
        <span class="tier-badge">S TIER</span>
        <img src="/images/HEROS/GENJI/GENJI_ICON.webp" alt="Genji" class="hero-list-img" />
        <h3 class="hero-list-title">GENJI</h3>
        <span class="hero-list-badge">DAMAGE</span>
        <p class="hero-list-desc">Agile cyber-ninja with deadly precision</p>
        <button class="hero-list-btn">VIEW BUILDS</button>
      </a>

      <a href="builds_ashe.html" class="hero-card-list a-tier">
        <span class="tier-badge">A TIER</span>
        <img src="/images/HEROS/ASHE/ASHE_ICON.webp" alt="Ashe" class="hero-list-img" />
        <h3 class="hero-list-title">ASHE</h3>
        <span class="hero-list-badge">DAMAGE</span>
        <p class="hero-list-desc">Versatile sniper with area control abilities</p>
        <button class="hero-list-btn">VIEW BUILDS</button>
      </a>

      <a href="builds_cassidy.html" class="hero-card-list a-tier">
        <span class="tier-badge">A TIER</span>
        <img src="/images/HEROS/CASSIDY/CASSIDY_ICON.webp" alt="Cassidy" class="hero-list-img" />
        <h3 class="hero-list-title">CASSIDY</h3>
        <span class="hero-list-badge">DAMAGE</span>
        <p class="hero-list-desc">Skilled gunslinger with high burst damage</p>
        <button class="hero-list-btn">VIEW BUILDS</button>
      </a>

      <a href="builds_soldier76.html" class="hero-card-list b-tier">
        <span class="tier-badge">B TIER</span>
        <img src="/images/HEROS/SOLDIER76/SOLDIER76_ICON.webp" alt="Soldier: 76" class="hero-list-img" />
        <h3 class="hero-list-title">SOLDIER: 76</h3>
        <span class="hero-list-badge">DAMAGE</span>
        <p class="hero-list-desc">Versatile soldier with consistent damage output</p>
        <button class="hero-list-btn">VIEW BUILDS</button>
      </a>

      <a href="builds_reaper.html" class="hero-card-list b-tier">
        <span class="tier-badge">B TIER</span>
        <img src="/images/HEROS/REAPER/REAPER_ICON.webp" alt="Reaper" class="hero-list-img" />
        <h3 class="hero-list-title">REAPER</h3>
        <span class="hero-list-badge">DAMAGE</span>
        <p class="hero-list-desc">Close-range specialist with life-steal abilities</p>
        <button class="hero-list-btn">VIEW BUILDS</button>
      </a>

      <a href="builds_mei.html" class="hero-card-list b-tier">
        <span class="tier-badge">B TIER</span>
        <img src="/images/HEROS/MEI/MEI_ICON.webp" alt="Mei" class="hero-list-img" />
        <h3 class="hero-list-title">MEI</h3>
        <span class="hero-list-badge">DAMAGE</span>
        <p class="hero-list-desc">Area control specialist with freezing abilities</p>
        <button class="hero-list-btn">VIEW BUILDS</button>
      </a>
    </div>
  </section>
</MainLayout> 