---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout>
  <!-- Added elegant background and improved responsive structure -->
  <div class="min-h-screen bg-gradient-to-br from-[#181c22] via-[#23272A] to-[#1a232e] text-[#D8D8D8] font-['Inter']">
    <!-- Import required fonts and CSS -->
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Main layout fixed: responsive grid, max-w-4xl content -->
    <main class="container mx-auto px-4 py-12">
      <div class="w-full max-w-4xl mx-auto">
        <!-- Introduction -->
        <section class="mb-16 text-center">
          <h2 class="text-4xl font-['Bebas_Neue'] text-[#FFA000] neon-text mb-4 section-title">BIENVENUE SUR STADIUM META</h2>
          <p class="text-[#D8D8D8] max-w-2xl mx-auto text-lg">
            Découvrez le nouveau mode Stadium d'Overwatch 2 ! Un mode compétitif unique où chaque round compte. Gagnez du Stadium Cash pour acheter des Powers et des Items, et adaptez vos builds pour écraser vos adversaires. Plongez dans l'arène !
          </p>
          <a href="/fr/heroes" class="mt-6 inline-block btn-orange text-[#23272A] px-6 py-3 rounded-md font-['Bebas_Neue'] text-lg">DÉCOUVRIR LES HÉROS MÉTA</a>
        </section>
      </div>
    </main>

    <!-- Footer -->
    <footer class="footer mt-12">
      <div class="container mx-auto px-4 text-center text-[#A9B8BB]">
        <p class="mb-4">© 2025 Stadium Meta. Créé pour les fans d'Overwatch 2.</p>
        <div class="flex justify-center gap-6">
          <a href="#" class="hover:text-[#FFA000] transition"><i class="fab fa-twitter"></i> Twitter</a>
          <a href="#" class="hover:text-[#FFA000] transition"><i class="fab fa-discord"></i> Discord</a>
          <a href="#" class="hover:text-[#FFA000] transition"><i class="fab fa-youtube"></i> YouTube</a>
        </div>
      </div>
    </footer>
  </div>
</MainLayout>