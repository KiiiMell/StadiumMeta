---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout>
  <section class="role-section">
    <h1 class="role-title">
      <img src="/images/ICONES_ROLES/Dark_Circle_Tank.png" alt="Tank" class="role-logo" />
      TANK HEROES
    </h1>
    <div class="hero-grid">
      <a href="builds_dva.html" class="hero-card-list s-tier">
        <span class="tier-badge">S TIER</span>
        <img src="/images/HEROS/DVA/DVA_ICON.webp" alt="D.Va" class="hero-list-img" />
        <h3 class="hero-list-title">D.VA</h3>
        <span class="hero-list-badge">TANK</span>
        <p class="hero-list-desc">Highly mobile tank with great defensive abilities</p>
        <button class="hero-list-btn">VIEW BUILDS</button>
      </a>
      
      <a href="builds_reinhardt.html" class="hero-card-list a-tier">
        <span class="tier-badge">A TIER</span>
        <img src="/images/HEROS/REINHARDT/REINHARDT_ICON.webp" alt="Reinhardt" class="hero-list-img" />
        <h3 class="hero-list-title">REINHARDT</h3>
        <span class="hero-list-badge">TANK</span>
        <p class="hero-list-desc">Strong shield tank with powerful melee attacks</p>
        <button class="hero-list-btn">VIEW BUILDS</button>
      </a>

      <a href="builds_zarya.html" class="hero-card-list a-tier">
        <span class="tier-badge">A TIER</span>
        <img src="/images/HEROS/ZARYA/ZARYA_ICON.webp" alt="Zarya" class="hero-list-img" />
        <h3 class="hero-list-title">ZARYA</h3>
        <span class="hero-list-badge">TANK</span>
        <p class="hero-list-desc">Energy-based tank with protective barriers</p>
        <button class="hero-list-btn">VIEW BUILDS</button>
      </a>

      <a href="builds_orisa.html" class="hero-card-list b-tier">
        <span class="tier-badge">B TIER</span>
        <img src="/images/HEROS/ORISA/ORISA_ICON.webp" alt="Orisa" class="hero-list-img" />
        <h3 class="hero-list-title">ORISA</h3>
        <span class="hero-list-badge">TANK</span>
        <p class="hero-list-desc">Defensive anchor tank with fortification abilities</p>
        <button class="hero-list-btn">VIEW BUILDS</button>
      </a>

      <a href="builds_junkerqueen.html" class="hero-card-list b-tier">
        <span class="tier-badge">B TIER</span>
        <img src="/images/HEROS/JUNKERQUEEN/JUNKERQUEEN_ICON.webp" alt="Junker Queen" class="hero-list-img" />
        <h3 class="hero-list-title">JUNKER QUEEN</h3>
        <span class="hero-list-badge">TANK</span>
        <p class="hero-list-desc">Aggressive tank with life-steal mechanics</p>
        <button class="hero-list-btn">VIEW BUILDS</button>
      </a>
    </div>
  </section>
</MainLayout> 