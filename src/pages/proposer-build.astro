---
import MainLayout from '../layouts/MainLayout.astro';
---
<style>
  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 30vh;
    background: none;
  }
  .hero-title-3-block {
    margin: 0 auto 24px auto;
    width: fit-content;
    text-align: center;
  }
  .hero-title-3-underline {
    margin: 0 auto 8px auto;
    width: 320px;
    max-width: 90vw;
    height: 7px;
    border-radius: 10px;
    background: linear-gradient(90deg, #2196F3 0%, #fff 13%, #FFA000 50%, #fff 87%, #2196F3 100%);
    box-shadow: 0 0 20px 4px #2196F3cc, 0 0 20px 8px #FFA00066;
    opacity: 1;
  }
  .hero-title-3-center-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 4px;
  }
  .hero-title.hero-title-3 {
    font-size: 2.1rem;
    font-family: 'Bebas Neue', 'Montserrat', Arial, sans-serif;
    font-weight: 900;
    letter-spacing: 2px;
    color: #FFA000;
    text-shadow: 0 2px 14px #2196F3cc, 0 0px 18px #FFA00099, 0 0 0.5px #2196F3;
    margin: 0 8px;
    text-transform: uppercase;
  }
  .container-main {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 16px 40px 16px;
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    box-sizing: border-box;
    overflow-x: hidden;
  }
  .build-form {
    max-width: 500px;
    margin: 0 auto 40px auto;
    background: rgba(24,28,34,0.98);
    border-radius: 18px;
    box-shadow: 0 8px 40px #0006, 0 1.5px 8px #FFA00044;
    padding: 32px 24px 24px 24px;
    border: 1.5px solid #23272a;
    color: #fff;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .build-form label {
    display: block;
    margin-bottom: 8px;
    font-weight: 700;
    color: #FFA000;
    margin-top: 8px;
  }
  .build-form input, .build-form textarea, .build-form select {
    width: 100%;
    padding: 10px;
    margin-bottom: 18px;
    border-radius: 8px;
    border: 1px solid #23272a;
    background: #181c22;
    color: #fff;
    font-size: 1rem;
    transition: border 0.13s, box-shadow 0.13s;
    box-sizing: border-box;
  }
  .build-form input:focus, .build-form textarea:focus, .build-form select:focus {
    outline: none;
    border: 1.5px solid #FFA000;
    box-shadow: 0 0 10px #FFA00044;
  }
  .build-form button {
    background: linear-gradient(90deg, #FFA000 80%, #FFD54F 100%);
    color: #181c22;
    font-weight: 900;
    font-size: 1.1rem;
    padding: 12px 36px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    transition: background 0.18s, transform 0.16s;
    box-shadow: 0 2px 12px #FFA00044;
    margin-top: 8px;
  }
  .build-form button:hover {
    background: linear-gradient(90deg, #FFD54F 60%, #FFA000 100%);
    color: #181c22;
    transform: translateY(-2px) scale(1.04);
    box-shadow: 0 4px 20px #FFA00033;
  }
  .success-message {
    color: #4caf50;
    font-weight: bold;
    margin-bottom: 18px;
  }
  .error-message {
    color: #f44336;
    font-weight: bold;
    margin-bottom: 18px;
  }
</style>
<MainLayout>
  <section class="hero-section hero-section-center-flex">
    <div class="hero-title-3-block">
      <div class="hero-title-3-underline"></div>
      <div class="hero-title-3-center-wrap">
        <span class="hero-title hero-title-3 split-left">PROPOSER UN BUILD</span>
      </div>
      <div class="hero-title-3-underline hero-title-3-underline-bottom"></div>
    </div>
  </section>
  <main class="container-main">
    <form class="build-form" id="buildForm">
      <h2>Proposer un build communautaire</h2>
      <label for="auteur">Pseudo (optionnel)</label>
      <input type="text" id="auteur" name="auteur" placeholder="Ton pseudo" />
      <label for="hero">Héros</label>
      <select id="hero" name="hero" required>
        <option value="">Choisir un héros</option>
        <option>Orisa</option>
        <option>Zarya</option>
        <option>Reinhardt</option>
        <option>D.Va</option>
        <option>Junker Queen</option>
        <!-- Ajoute d'autres héros ici -->
      </select>
      <label for="titre">Titre du build</label>
      <input type="text" id="titre" name="titre" placeholder="Titre du build" required />
      <label for="description">Description / stratégie</label>
      <textarea id="description" name="description" rows="4" placeholder="Explique le principe du build" required></textarea>
      <label for="details">Détails techniques (facultatif)</label>
      <textarea id="details" name="details" rows="3" placeholder="Ex : perks, talents, combos..."></textarea>
      <button type="submit">Envoyer</button>
      <div class="success-message" id="successMsg" style="display:none"></div>
      <div class="error-message" id="errorMsg" style="display:none"></div>
    </form>
  </main>
  <script>
    const form = document.getElementById('buildForm');
    const successMsg = document.getElementById('successMsg');
    const errorMsg = document.getElementById('errorMsg');
    form.onsubmit = async (e) => {
      e.preventDefault();
      successMsg.style.display = 'none';
      errorMsg.style.display = 'none';
      const data = {
        auteur: form.auteur.value,
        hero: form.hero.value,
        titre: form.titre.value,
        description: form.description.value,
        details: form.details.value
      };
      try {
        const res = await fetch('http://localhost:4000/api/builds', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (res.ok) {
          successMsg.textContent = 'Build envoyé ! Merci pour ta participation.';
          successMsg.style.display = 'block';
          form.reset();
        } else {
          errorMsg.textContent = 'Erreur lors de l’envoi. Merci de réessayer.';
          errorMsg.style.display = 'block';
        }
      } catch (err) {
        errorMsg.textContent = 'Erreur réseau. Merci de réessayer.';
        errorMsg.style.display = 'block';
      }
    };
  </script>
</MainLayout>
